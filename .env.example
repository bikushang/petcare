# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017

# Optional database name; defaults to petcare_pro
MONGODB_DB=petcare_pro

# Required: use a unique random secret with at least 32 characters
JWT_SECRET=replace-with-a-long-random-secret

# Optional Express API port; defaults to 3001
API_PORT=3001

# Optional frontend API base URL, only set if needed
# NEXT_PUBLIC_API_BASE_URL=
